{
  "name": "MLModel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "default": "signal_predictor"
    },
    "version": {
      "type": "number",
      "default": 0
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Logistic regression weights (bias first)"
    },
    "trained_samples": {
      "type": "number",
      "default": 0
    },
    "loss_updates": {
      "type": "number",
      "default": 0,
      "description": "Number of updates triggered by losing trades"
    },
    "accuracy": {
      "type": "number",
      "default": 0,
      "description": "Prequential walk-forward accuracy %"
    },
    "last_loss": {
      "type": "number",
      "default": 0,
      "description": "Prequential walk-forward log-loss"
    },
    "validation_samples": {
      "type": "number",
      "default": 0,
      "description": "Number of prequential out-of-sample predictions"
    },
    "validation_method": {
      "type": "string",
      "default": "prequential-walk-forward"
    },
    "trained_trade_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Per-version snapshots: version, accuracy, loss, samples, trigger"
    }
  },
  "required": [
    "name"
  ]
}